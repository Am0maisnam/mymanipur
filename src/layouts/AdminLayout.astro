---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const userEmail = await Astro.session?.get("userEmail");

const navLinks = [
  { href: "/admin", label: "Dashboard" },
  { href: "/admin/articles", label: "Articles" },
  { href: "/admin/authors", label: "Authors" },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title} | MyManipur Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface font-sans text-on-background min-h-screen flex flex-col lg:flex-row">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <aside class="w-full lg:w-56 shrink-0 border-b lg:border-b-0 lg:border-r border-outline-variant bg-surface-container-lowest lg:min-h-screen flex flex-col">
      <div class="h-16 flex items-center justify-between px-6 border-b border-outline-variant lg:border-b lg:justify-start">
        <a href="/" class="text-label-caps text-on-surface uppercase tracking-widest">MyManipur Admin</a>
      </div>
      <nav class="flex flex-row lg:flex-col overflow-x-auto p-4 gap-1 lg:flex-1">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="px-3 py-2 rounded-md text-body-md text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors whitespace-nowrap"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="p-4 border-t border-outline-variant">
        {userEmail && <p class="text-metadata text-on-surface-variant mb-3 truncate">{userEmail}</p>}
        <form method="POST" action="/admin/logout">
          <button
            type="submit"
            class="w-full text-left px-3 py-2 rounded-md text-body-md text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors"
          >
            Log Out
          </button>
        </form>
      </div>
    </aside>
    <main id="main-content" class="flex-1 min-h-screen min-w-0">
      <div class="max-w-5xl mx-auto px-4 sm:px-8 py-10">
        <slot />
      </div>
    </main>
  </body>
</html>
