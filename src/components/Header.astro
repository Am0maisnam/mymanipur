---
import { navItems } from "../lib/categories";

const today = new Date().toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
});
---

<header class="fixed top-0 w-full z-50 bg-surface/90 backdrop-blur-md border-b border-outline-variant">
  <div class="h-16 max-w-container mx-auto px-margin-mobile md:px-margin-desktop flex items-center justify-between gap-gutter">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="/images/logo.png" alt="MyManipur" class="h-9 md:h-10 w-auto object-contain" />
    </a>

    <nav class="hidden lg:flex items-center gap-6">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            class="font-sans text-label-caps text-on-surface-variant hover:text-primary transition-colors uppercase"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 md:gap-6">
      <div class="hidden md:flex flex-col items-end">
        <span class="font-sans text-[10px] text-on-surface-variant uppercase tracking-widest">Regional Edition</span>
        <span class="font-sans text-metadata text-on-surface">{today}</span>
      </div>
      <a href="/search" aria-label="Search" class="p-2 hover:bg-surface-container rounded-full transition-colors">
        <span class="material-symbols-outlined text-on-surface">search</span>
      </a>
      <a
        href="/admin/login"
        aria-label="Admin login"
        class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"
      >
        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
      </a>
      <button
        id="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="lg:hidden p-2 hover:bg-surface-container rounded-full transition-colors"
      >
        <span id="nav-toggle-icon" class="material-symbols-outlined text-on-surface">menu</span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden lg:hidden bg-surface border-t border-outline-variant"
  >
    <div class="flex flex-col px-margin-mobile py-4">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            class="font-sans text-label-caps text-on-surface-variant hover:text-primary transition-colors uppercase py-3 border-b border-outline-variant/50 last:border-b-0"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle")!;
  const icon = document.getElementById("nav-toggle-icon")!;
  const panel = document.getElementById("mobile-nav")!;

  toggle.addEventListener("click", () => {
    const isOpen = !panel.classList.contains("hidden");
    panel.classList.toggle("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
    icon.textContent = isOpen ? "menu" : "close";
  });

  panel.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      panel.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      icon.textContent = "menu";
    });
  });
</script>
