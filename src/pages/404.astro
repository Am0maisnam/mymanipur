---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

Astro.response.status = 404;
---

<BaseLayout title="Page Not Found">
  <Header />
  <main class="w-full pt-16 min-h-screen flex items-center">
    <section class="max-w-container mx-auto px-margin-mobile md:px-margin-desktop py-section-gap w-full text-center">
      <p class="text-label-caps text-primary uppercase tracking-widest mb-4">404</p>
      <h1 class="text-headline-lg text-on-surface mb-4">Page not found</h1>
      <p class="text-body-lg text-on-surface-variant mb-8 max-w-xl mx-auto">
        The story you're looking for may have moved, been archived, or never existed. Try the homepage or search
        instead.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a
          href="/"
          class="px-6 py-3 bg-primary text-on-primary text-label-caps uppercase tracking-wider rounded-md hover:opacity-90 transition-opacity"
        >
          Back to Home
        </a>
        <a
          href="/search"
          class="px-6 py-3 bg-transparent border border-primary text-primary text-label-caps uppercase tracking-wider rounded-md hover:bg-primary hover:text-on-primary transition-colors"
        >
          Search
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
