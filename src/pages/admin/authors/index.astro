---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import { getAuthors, createAuthor } from "../../../lib/authors";

const db = env.DB;
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const name = String(form.get("name") ?? "").trim();
  if (!name) {
    error = "Name is required.";
  } else {
    await createAuthor(db, name, String(form.get("bio") ?? "").trim() || undefined);
    return Astro.redirect("/admin/authors");
  }
}

const authors = await getAuthors(db);
---

<AdminLayout title="Authors">
  <h1 class="text-headline-lg text-on-surface mb-8">Authors</h1>

  <div class="border border-outline-variant rounded-lg divide-y divide-outline-variant mb-10 max-w-xl">
    {
      authors.map((author) => (
        <div class="p-4">
          <p class="text-body-md text-on-surface">{author.name}</p>
          {author.bio && <p class="text-metadata text-on-surface-variant">{author.bio}</p>}
        </div>
      ))
    }
    {authors.length === 0 && <p class="p-4 text-body-md text-on-surface-variant">No authors yet.</p>}
  </div>

  <h2 class="text-headline-md text-on-surface mb-4">Add Author</h2>
  {error && <p class="text-body-md text-error mb-4">{error}</p>}
  <form method="POST" class="flex flex-col gap-4 max-w-md">
    <div>
      <label for="name" class="text-label-caps text-on-surface-variant uppercase block mb-2">Name</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        class="w-full bg-transparent border-b border-primary py-2 outline-none text-body-md"
      />
    </div>
    <div>
      <label for="bio" class="text-label-caps text-on-surface-variant uppercase block mb-2">Bio (optional)</label>
      <textarea id="bio" name="bio" rows="2" class="w-full bg-transparent border-b border-outline-variant py-2 outline-none text-body-md resize-y" />
    </div>
    <button
      type="submit"
      class="self-start px-6 py-3 bg-primary text-on-primary text-label-caps uppercase tracking-wider rounded-md hover:opacity-90 transition-opacity"
    >
      Add Author
    </button>
  </form>
</AdminLayout>
