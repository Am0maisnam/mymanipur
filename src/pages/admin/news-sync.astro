---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import {
  archiveIrrelevantPublishedWire,
  autoPublishEnabled,
  getHeldDrafts,
  getRecentSyncRuns,
  providerConfigs,
  runNewsSync,
  type SyncEnv,
  type SyncOutcome,
} from "../../lib/newsSync";

const syncEnv = env as unknown as SyncEnv;
const db = env.DB;
const configs = providerConfigs(syncEnv);
const autoPublish = autoPublishEnabled(syncEnv);

let outcome: SyncOutcome | null = null;
let recheck: { checked: number; archived: string[] } | null = null;
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  try {
    if (action === "recheck") {
      recheck = await archiveIrrelevantPublishedWire(db);
    } else {
      const providerId = String(form.get("providerId") ?? "") || undefined;
      outcome = await runNewsSync(syncEnv, "manual", providerId);
    }
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}

const runs = await getRecentSyncRuns(db, 10);
const held = await getHeldDrafts(db);
---

<AdminLayout title="News Sync">
  <h1 class="text-headline-lg text-on-surface mb-4">News Autopilot</h1>
  <div class="text-body-md text-on-surface-variant mb-8 max-w-3xl space-y-2">
    <p>
      Runs automatically every 30 minutes. Each story is checked: <strong>not about Manipur</strong> or a
      <strong>duplicate</strong> is skipped; anything <strong>sensitive</strong> (violence, communities, security
      operations, shutdowns) or only loosely relevant is held below for an editor; clear Manipur stories are
      published with the original source credited and linked.
    </p>
    <p>
      Auto-publish is currently
      <strong class={autoPublish ? "text-primary" : "text-error"}>{autoPublish ? "ON" : "OFF — everything is held for review"}</strong>
      (<code>AUTOPUBLISH</code> variable).
    </p>
  </div>

  {error && <p class="text-body-md text-error mb-6 max-w-2xl">{error}</p>}
  {
    outcome && (
      <p class="text-body-md text-primary mb-6">
        Fetched {outcome.result.fetched} from {outcome.providersRun.join(", ") || "no provider"}: {outcome.result.published} published,{" "}
        {outcome.result.heldForReview} held, {outcome.result.skippedIrrelevant} not about Manipur,{" "}
        {outcome.result.skippedDuplicate} duplicates, {outcome.result.skippedExisting} already had.
        {outcome.result.errors.length > 0 && ` Errors: ${outcome.result.errors.join("; ")}`}
      </p>
    )
  }
  {
    recheck && (
      <p class="text-body-md text-primary mb-6">
        Checked {recheck.checked} published wire stories, archived {recheck.archived.length}
        {recheck.archived.length > 0 && `: ${recheck.archived.join(" · ")}`}
      </p>
    )
  }

  <div class="flex flex-wrap gap-4 mb-12">
    {
      configs.map((config) => (
        <form method="POST">
          <input type="hidden" name="action" value="sync" />
          <input type="hidden" name="providerId" value={config.id} />
          <button
            type="submit"
            class="px-6 py-3 bg-primary text-on-primary text-label-caps uppercase tracking-wider rounded-md hover:opacity-90 transition-opacity disabled:opacity-40 disabled:cursor-not-allowed"
            disabled={!config.apiKey}
            title={config.apiKey ? undefined : `Run: ${config.setupCommand}`}
          >
            Sync now: {config.provider.name}
            {!config.apiKey && " (not configured)"}
          </button>
        </form>
      ))
    }
    <form method="POST">
      <input type="hidden" name="action" value="recheck" />
      <button
        type="submit"
        class="px-6 py-3 border border-primary text-primary text-label-caps uppercase tracking-wider rounded-md hover:bg-primary hover:text-on-primary transition-colors"
      >
        Archive off-topic published stories
      </button>
    </form>
  </div>

  <h2 class="text-headline-md text-on-surface mb-4">Held for review ({held.length})</h2>
  <div class="border border-outline-variant rounded-lg divide-y divide-outline-variant mb-12">
    {
      held.map((article) => (
        <a
          href={`/admin/articles/${article.id}/edit`}
          class="flex flex-col gap-1 p-4 hover:bg-surface-container-low transition-colors"
        >
          <p class="text-body-md text-on-surface">{article.title}</p>
          <p class="text-metadata text-on-surface-variant">
            {article.source ?? "Unknown source"} · {article.categoryName} · {article.reviewReason ?? "Needs review"}
          </p>
        </a>
      ))
    }
    {held.length === 0 && <p class="p-4 text-body-md text-on-surface-variant">Nothing waiting.</p>}
  </div>

  <h2 class="text-headline-md text-on-surface mb-4">Recent runs</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-metadata text-on-surface">
      <thead>
        <tr class="text-left text-on-surface-variant border-b border-outline-variant">
          <th class="py-2 pr-4">When (UTC)</th><th class="pr-4">Trigger</th><th class="pr-4">Providers</th>
          <th class="pr-4">Fetched</th><th class="pr-4">Published</th><th class="pr-4">Held</th><th class="pr-4">Skipped</th><th>Errors</th>
        </tr>
      </thead>
      <tbody>
        {
          runs.map((run) => (
            <tr class="border-b border-outline-variant/50 align-top">
              <td class="py-2 pr-4 whitespace-nowrap">{run.ranAt}</td>
              <td class="pr-4">{run.trigger}</td>
              <td class="pr-4">{run.providers || "—"}</td>
              <td class="pr-4">{run.fetched}</td>
              <td class="pr-4">{run.published}</td>
              <td class="pr-4">{run.held}</td>
              <td class="pr-4">{run.skipped}</td>
              <td class="text-error">{run.errors ?? ""}</td>
            </tr>
          ))
        }
        {runs.length === 0 && (
          <tr><td colspan="8" class="py-4 text-on-surface-variant">No runs recorded yet.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
