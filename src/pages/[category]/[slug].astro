---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ImpactCallout from "../../components/ImpactCallout.astro";
import { getArticleBySlug, getRelatedArticles, estimateReadTime, formatPublished } from "../../lib/articles";
import { env } from "cloudflare:workers";

const db = env.DB;
const { category: categorySlug, slug } = Astro.params;

const article = await getArticleBySlug(db, categorySlug!, slug!);
if (!article) {
  return Astro.rewrite("/404");
}

const related = await getRelatedArticles(db, article);
const publishedLabel = new Date(article.publishedAt).toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const canonicalUrl = new URL(`/${article.categorySlug}/${article.slug}`, Astro.url.origin).toString();
const imageUrl = article.featuredImageUrl
  ? new URL(article.featuredImageUrl, Astro.url.origin).toString()
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: article.title,
  description: article.excerpt,
  image: imageUrl ? [imageUrl] : undefined,
  datePublished: article.publishedAt,
  dateModified: article.publishedAt,
  author: { "@type": "Person", name: article.authorName },
  publisher: {
    "@type": "Organization",
    name: "MyManipur",
    logo: { "@type": "ImageObject", url: new URL("/images/logo.png", Astro.url.origin).toString() },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  articleSection: article.categoryName,
  keywords: article.tags.join(", ") || undefined,
};
---

<BaseLayout
  title={article.title}
  description={article.excerpt}
  image={article.featuredImageUrl ?? undefined}
  type="article"
  publishedTime={article.publishedAt}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Header />
  <main class="w-full pt-16 min-h-screen">
    <article class="max-w-container mx-auto px-margin-mobile md:px-margin-desktop py-12 w-full">
      <nav class="text-metadata text-on-surface-variant mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href={`/${article.categorySlug}`} class="hover:text-primary transition-colors">{article.categoryName}</a>
        <span class="mx-2">/</span>
        <span class="text-on-surface line-clamp-1">{article.title}</span>
      </nav>

      <div class="max-w-3xl mx-auto">
        <a href={`/${article.categorySlug}`} class="text-label-caps text-primary uppercase tracking-widest mb-4 block">
          {article.categoryName}
        </a>
        <h1 class="text-display-lg text-on-surface mb-6 leading-tight">{article.title}</h1>
        <p class="text-body-lg text-on-surface-variant mb-6">{article.excerpt}</p>
        <div class="flex flex-wrap items-center gap-4 text-on-surface-variant text-metadata pb-8 mb-8 border-b border-outline-variant">
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">edit</span>
            {article.authorName}
          </span>
          <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">schedule</span>
            {publishedLabel}
          </span>
          <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">menu_book</span>
            {estimateReadTime(article.contentHtml)}
          </span>
        </div>
      </div>

      {article.featuredImageUrl && (
        <div class="max-w-3xl mx-auto mb-10">
          <figure>
            <img
              src={article.featuredImageUrl}
              alt={article.imageCaption ?? article.title}
              class="w-full aspect-[16/9] object-cover rounded-xl"
            />
            {article.imageCaption && (
              <figcaption class="text-metadata text-on-surface-variant mt-2">{article.imageCaption}</figcaption>
            )}
          </figure>
        </div>
      )}

      {article.localImpactSummary && (
        <div class="max-w-3xl mx-auto mb-10">
          <ImpactCallout summary={article.localImpactSummary} />
        </div>
      )}

      <div class="max-w-3xl mx-auto text-body-lg text-on-surface space-y-6" set:html={article.contentHtml} />

      {article.tags.length > 0 && (
        <div class="max-w-3xl mx-auto flex flex-wrap gap-2 mt-10">
          {article.tags.map((tag) => (
            <span class="px-3 py-1 bg-surface-container text-metadata text-on-surface-variant rounded-sm">{tag}</span>
          ))}
        </div>
      )}

      <div class="max-w-3xl mx-auto flex items-center gap-4 mt-10 pt-8 border-t border-outline-variant">
        <span class="text-label-caps text-on-surface-variant uppercase">Share</span>
        <span class="material-symbols-outlined text-on-surface-variant cursor-pointer hover:text-primary">share</span>
        <span class="material-symbols-outlined text-on-surface-variant cursor-pointer hover:text-primary">alternate_email</span>
      </div>

      {
        related.length > 0 && (
          <div class="mt-section-gap">
            <div class="flex items-center justify-between pb-4 mb-8 border-b-2 border-primary">
              <h2 class="text-headline-lg text-on-surface">Related Stories</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              {related.map((item) => (
                <ArticleCard article={item} />
              ))}
            </div>
          </div>
        )
      }
    </article>
  </main>
  <Footer />
</BaseLayout>
