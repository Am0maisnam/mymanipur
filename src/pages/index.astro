---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BreakingNewsTicker from "../components/BreakingNewsTicker.astro";
import HeroArticle from "../components/HeroArticle.astro";
import ArticleCard from "../components/ArticleCard.astro";
import LiveUpdatesFeed from "../components/LiveUpdatesFeed.astro";
import ImpactSection from "../components/ImpactSection.astro";
import { getFeaturedArticle, getLatestArticles, getBreakingArticle, getImpactArticles, articleHref } from "../lib/articles";
import { env } from "cloudflare:workers";

const db = env.DB;

const featuredArticle = await getFeaturedArticle(db);
const latest = await getLatestArticles(db, 16);
const rest = latest.filter((a) => a.id !== featuredArticle?.id);
const topStories = rest.slice(0, 4);
const latestUpdates = rest.slice(4, 12);
const breakingArticle = await getBreakingArticle(db);
const impactArticles = await getImpactArticles(db);
---

<BaseLayout title="Home">
  <Header />
  <main id="main-content" class="w-full pt-16 min-h-screen">
    {breakingArticle && <BreakingNewsTicker text={breakingArticle.title} href={articleHref(breakingArticle)} />}

    {featuredArticle && <HeroArticle article={featuredArticle} />}

    <section class="max-w-container mx-auto px-margin-mobile md:px-margin-desktop py-section-gap w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
        <div class="lg:col-span-8 flex flex-col gap-12">
          <div class="flex items-center justify-between pb-4 border-b-2 border-primary">
            <h2 class="text-headline-lg text-on-surface">Top Stories</h2>
            <a href="/manipur" class="text-metadata text-primary hover:underline underline-offset-4 flex items-center gap-1">
              View All
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {topStories.map((article) => <ArticleCard article={article} />)}
          </div>

        </div>

        <LiveUpdatesFeed articles={latestUpdates.length > 0 ? latestUpdates : rest.slice(0, 8)} />
      </div>
    </section>

    <ImpactSection articles={impactArticles} />
  </main>
  <Footer />
</BaseLayout>
