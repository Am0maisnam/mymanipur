{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mymanipur",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mymanipur-db",
      "database_id": "cb27bdef-77e0-4f77-b390-5c99dc586361"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mymanipur-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "df8dfeb4ec0e46dd89d095d5f5b4b2fe"
    }
  ],
  // ADSENSE_CLIENT_ID is a public publisher ID (ca-pub-XXXXXXXXXXXX), not a
  // secret — it's meant to be embedded in every page's HTML.
  "vars": {
    "ADSENSE_CLIENT_ID": "ca-pub-9002721516543448"
  }
}
