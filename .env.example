# Documents the environment variables MyManipur will need as later phases add
# them. None of these are read by any code yet (Phase 2 is UI-only, no
# database/auth/ingestion). Copy to .env locally when a phase starts needing
# it; never commit the real .env file.

# Phase 4/5 — D1 database + admin auth
SESSION_SECRET=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Phase 6 — R2 image storage
# (bucket binding is configured in wrangler config, not an env var)

# Phase 7 — external news ingestion
# NEWS_API_KEY=

# General
SITE_URL=http://localhost:4321
